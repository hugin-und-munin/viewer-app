# Template – copy to .env.local and fill in real values
# .env.local is git-ignored and takes precedence over this file

CLIENT_ID=
CLIENT_SECRET=
VITE_API_URL=
VITE_DISABLE_CACHE=false
VITE_DISABLE_PREFETCH=false
VITE_CACHE_TTL_MS=0
VITE_APPSETTINGS_LOOKAHEAD_DAYS=3
VITE_CONTROL_ENABLED=false

# change / override if Piper isn't installed at the standard location
# installing piper: docs\piper-installation.md
PIPER_EXE=C:\Program Files\Piper\piper\piper.exe
PIPER_MODEL_MALE=C:\Program Files\Piper\piper\de_DE-thorsten-high.onnx
PIPER_MODEL_FEMALE=C:\Program Files\Piper\piper\de_DE-kerstin-low.onnx
